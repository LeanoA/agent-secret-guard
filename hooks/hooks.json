{
  "description": "agent-secret-guard: block agent access to secret files and git guardrail bypasses",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
